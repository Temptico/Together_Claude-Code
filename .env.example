# Together — environment variables
# Copy to .env for local development (the dev server loads nothing
# automatically; export them in your shell or use a tool like direnv).
# On Render, set these under Environment. In production the server refuses
# to start if any of the "required" ones is missing (see server/index.ts).

# ---- Required in production ----
# Neon Postgres connection string. Without it the server uses an embedded
# PGlite database in ./.pgdata (local development only).
DATABASE_URL=
# Web Push (VAPID) key pair. Generate once with: npx web-push generate-vapid-keys
# Keep them stable — changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Resend API key for login codes and welcome emails.
RESEND_API_KEY=
# Must be "production" on Render: enables serving the built client.
NODE_ENV=production

# ---- Optional ----
# Secret for the /admin dashboard. Without it the dashboard is disabled.
ADMIN_SECRET=
# Geoapify Places API key (free plan is fine). Primary source for nearby
# search; without it the public Overpass servers are used, which are often
# at capacity.
GEOAPIFY_API_KEY=
# Sentry DSNs: server-side error capture, and the client one is baked in at
# build time.
SENTRY_DSN=
VITE_SENTRY_DSN=
# HTTP port (default 3210).
PORT=3210
# Time zone for "today" and reminder hours (defaults to Europe/Ljubljana).
TZ=Europe/Ljubljana

# ---- Tests only ----
# PGLITE_DATA_DIR=memory://   (set by vitest.config.ts)

# ---- Date photos in object storage (optional, recommended) ----
# Cloudflare R2 bucket for date photos. Without these the photos are kept
# as base64 in the database (works, but grows the DB and every dates
# payload). Public base URL = the bucket's r2.dev URL or a custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=together-photos
R2_PUBLIC_URL=
