{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    },
    "noEmit": false
  },
  "include": ["server", "shared"],
  // Tests import vitest, a devDependency the production install doesn't
  // have — keep them out of the server build (tsconfig.json still checks them).
  "exclude": ["server/**/*.test.ts", "server/testUtils.ts"]
}
